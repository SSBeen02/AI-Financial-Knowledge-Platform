QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sisa_terms
DENSE_MODEL=nlpai-lab/KURE-v1
LLM_PROVIDER=openai
# 필수. 모델 카탈로그에서 계정에 사용 가능한 모델을 확인해 지정한다.
LLM_MODEL=
LLM_RELEVANCE_MODEL=
LLM_API_KEY=
# 모델이 reasoning.effort를 지원할 때만 지정한다. 미지원 모델은 빈 값으로 둔다.
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=1200
# 기본 0.7. reasoning.effort가 none이 아니거나 모델이 지원하지 않으면 요청에서 자동 생략한다.
LLM_TEMPERATURE=0.7
# hao: 조선시대 학당 훈장의 읽기 쉬운 하오체 / modern: 현대 해요체
CHAT_TONE=hao
# 상태 코드는 not_started/in_progress/passed, 화면 표시는 미학습/학습중/통과로 고정한다.
# false면 자유 질문은 세션을 시작하지 않고 학습 시작 제안만 반환한다.
FREE_QUESTION_AUTO_START=false
BAND_HIGH=0.50
BAND_LOW=0.45
DISPLAY_SOURCE_MIN_SCORE=0.60
STAGES_JSON_PATH=data/stages.json
# Supabase Dashboard > Connect > Session pooler에서 복사한 값을 SQLAlchemy psycopg 형식으로 바꾼다.
# CHAT_DB_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
CHAT_DB_URL=sqlite:///chat.db
# 개발 API와 /dev/chat 등록 여부. 배포에서는 false.
DEV_ENABLE_TOOLS=true
# true면 개발용 QuizService가 퀴즈 생성 실패를 반환한다.
DEV_SIMULATE_QUIZ_GENERATION_FAILURE=false
