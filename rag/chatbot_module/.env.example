# ===== Qdrant =====
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sisa_terms
DENSE_MODEL=nlpai-lab/KURE-v1

# ===== Upstage (사용 중) =====
LLM_PROVIDER=upstage
LLM_BASE_URL=https://api.upstage.ai/v1
LLM_MODEL=solar-pro4
LLM_API_KEY=
# 모델이 지원할 때만 지정한다. 미지원 모델은 빈 값으로 둔다. upstage는 effort 공백으로 둘 
#비우면 추론 끔 upstage는 추론 시 답변이 비는 문제가 있음
LLM_REASONING_EFFORT=

# ===== OpenAI (꺼 둠) =====
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.6-luna
# LLM_API_KEY=
# LLM_REASONING_EFFORT=low

# ===== LLM 공통 =====
# 비우면 LLM_MODEL을 관련성 판정에도 사용한다.
LLM_RELEVANCE_MODEL=
LLM_MAX_OUTPUT_TOKENS=1200
# OpenAI는 기존 모델 지원 규칙, Upstage는 reasoning_effort가 비어 있을 때만 전달한다.
LLM_TEMPERATURE=0.7

# ===== 답변·학습 동작 =====
# hao: 조선시대 학당 훈장의 읽기 쉬운 하오체 / modern: 현대 해요체
CHAT_TONE=hao
# true면 핵심 정의·기억할 포인트 1~2곳에 제한적으로 이모지를 사용한다.
CHAT_EMOJI=true
# dictionary_only(사전만) / dictionary_plus(기본, 일반 경제 상식 보충) / free(사전 참고)
ANSWER_KNOWLEDGE_MODE=dictionary_plus
# 상태 코드는 not_started/in_progress/passed, 화면 표시는 미학습/학습중/통과로 고정한다.
# false면 자유 질문은 세션을 시작하지 않고 학습 시작 제안만 반환한다.
FREE_QUESTION_AUTO_START=false

# ===== API·검색 =====
# 쉼표로 구분한다.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000
BAND_HIGH=0.50
BAND_LOW=0.45
DISPLAY_SOURCE_MIN_SCORE=0.60
STAGES_JSON_PATH=data/stages.json

# ===== DB =====
# Supabase Dashboard > Connect > Session pooler에서 복사한 값을 SQLAlchemy psycopg 형식으로 바꾼다.
# CHAT_DB_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
CHAT_DB_URL=sqlite:///chat.db
# 로컬 최초 실행 예시. 공유 Supabase에서는 false로 두고 migrations/001→002→003을 적용한다.
DB_AUTO_CREATE=true

# ===== 개발 도구 =====
# 개발 API와 /dev/chat 등록 여부. 배포에서는 false.
DEV_ENABLE_TOOLS=true
# true면 개발용 QuizService가 퀴즈 생성 실패를 반환한다.
DEV_SIMULATE_QUIZ_GENERATION_FAILURE=false
