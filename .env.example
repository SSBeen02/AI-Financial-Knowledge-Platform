# 로그인 미구현 상태의 단독 개발에서만 true. 통합 환경은 false.
DEV_MODE=true
# 개발용 저장소. 통합 환경에서는 supabase로 지정.
DIAGNOSTIC_REPOSITORY=memory
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 실제 Gemini 검증은 gemini로 변경하고 서버 환경에 키를 설정.
LLM_REPORT_MODE=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
